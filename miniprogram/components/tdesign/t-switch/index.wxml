<view class="t-switch t-switch--{{size}} {{value ? 't-switch--on' : ''}} {{disabled ? 't-switch--disabled' : ''}}"
      bindtap="onTap">
  <view class="t-switch__dot">
    <view wx:if="{{value}}" class="t-switch__check"></view>
  </view>
</view>
<text wx:if="{{label}}" class="t-switch__label">{{label}}</text>
