/* components/tdesign/t-empty/index.wxss */
.t-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  text-align: center;
}

.t-empty--small  { padding: 40rpx 24rpx; }
.t-empty--medium { padding: 80rpx 32rpx; }
.t-empty--large  { padding: 120rpx 40rpx; }

.t-empty__icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}
.t-empty--small .t-empty__icon { width: 120rpx; height: 120rpx; }
.t-empty--large .t-empty__icon { width: 280rpx; height: 280rpx; }

.t-empty__image { width: 100%; height: 100%; }
.t-empty__emoji { font-size: 120rpx; line-height: 1; }
.t-empty--small .t-empty__emoji { font-size: 80rpx; }
.t-empty--large .t-empty__emoji { font-size: 160rpx; }

.t-empty__desc {
  font-size: 26rpx;
  color: #8A8278;
  letter-spacing: 0.5rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
  max-width: 480rpx;
}
.t-empty--small .t-empty__desc { font-size: 24rpx; }

.t-empty__action {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #FF7B00;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  border: 1rpx solid #FF7B00;
  border-radius: 1000rpx;
  background: #FFFDF9;
  transition: opacity 0.12s;
}
.t-empty__action:active { opacity: 0.7; }
