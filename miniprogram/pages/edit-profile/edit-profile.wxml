<!-- pages/edit-profile/edit-profile.wxml — 编辑资料页 -->
<view class="page-edit-profile">
  <!-- 头像 -->
  <view class="section">
    <view class="avatar-section" bindtap="onAvatarTap">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{avatarUrl || defaultAvatar}}" mode="aspectFill" />
        <view class="avatar-overlay">
          <text class="avatar-edit-text">编辑</text>
        </view>
      </view>
      <text class="avatar-label">点击更换头像</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">基本信息</view>

    <view class="field-item">
      <text class="field-label">昵称</text>
      <input
        class="field-input"
        type="text"
        value="{{nickName}}"
        placeholder="请输入昵称"
        maxlength="20"
        bindinput="onNicknameInput"
        auto-focus
      />
      <text class="field-count">{{nickName.length}}/20</text>
    </view>

    <view class="field-item">
      <text class="field-label">性别</text>
      <view class="gender-selector">
        <view
          class="gender-option {{gender === 0 ? 'gender-active' : ''}}"
          bindtap="onGenderSelect"
          data-gender="0"
        >
          <text class="gender-icon">⚲</text>
          <text>保密</text>
        </view>
        <view
          class="gender-option {{gender === 1 ? 'gender-active' : ''}}"
          bindtap="onGenderSelect"
          data-gender="1"
        >
          <text class="gender-icon">♂</text>
          <text>男</text>
        </view>
        <view
          class="gender-option {{gender === 2 ? 'gender-active' : ''}}"
          bindtap="onGenderSelect"
          data-gender="2"
        >
          <text class="gender-icon">♀</text>
          <text>女</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="section">
    <view class="section-title">联系方式</view>
    <view class="field-item">
      <text class="field-label">手机号</text>
      <view class="phone-display">
        <text class="phone-text">{{phone || '未绑定'}}</text>
        <text wx:if="{{!phone}}" class="phone-bind" bindtap="onBindPhone">去绑定</text>
        <text wx:else class="phone-badge">已绑定</text>
      </view>
    </view>
  </view>

  <!-- 其他信息 -->
  <view class="section">
    <view class="section-title">其他</view>
    <view class="field-item">
      <text class="field-label">个人简介</text>
      <input
        class="field-input"
        type="text"
        value="{{bio}}"
        placeholder="介绍自己吧（选填）"
        maxlength="50"
        bindinput="onBioInput"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="save-btn" bindtap="onSave" disabled="{{!saving}}">
      <text wx:if="{{saving}}">保存中...</text>
      <text wx:else>保存</text>
    </button>
  </view>
</view>
