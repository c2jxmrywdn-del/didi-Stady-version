/* pages/riding/riding.wxss — 极简行程页 */
.page-riding {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100vh;
}

.top-bar {
  position: fixed;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
}

.top-status {
  background: #FFFDF9;
  border-radius: 8rpx;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #EDE8E0;
}

/* CSS状态指示点 */
.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.status-riding .status-dot { background: #111; }
.status-arriving .status-dot { background: #34c759; }
.status-arrived .status-dot { background: #34c759; }

.top-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #111;
}

/* 后台模拟提示条 */
.bg-hint {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(45, 42, 38, 0.92);
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  z-index: 200;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
.bg-hint-text {
  font-size: 24rpx;
  color: #fff;
  letter-spacing: 0.5rpx;
  font-weight: 500;
}

.safety-bar {
  position: fixed;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 100;
}

.safety-item {
  width: 80rpx;
  background: #FFFDF9;
  border-radius: 8rpx;
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #EDE8E0;
}

/* CSS安全图标 */
.safety-icon-view {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
/* 分享：箭头外框 */
.si-share {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #111;
  border-radius: 4rpx;
  position: relative;
}
.si-share::after {
  content: "";
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid #111;
  border-bottom: 3rpx solid transparent;
  border-top: 3rpx solid transparent;
}
/* 求助：感叹号 */
.si-help {
  width: 3rpx;
  height: 14rpx;
  background: #111;
  position: relative;
}
.si-help::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #111;
}
/* 电话：听筒 */
.si-phone {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #111;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.safety-text {
  font-size: 18rpx;
  color: #666;
}

.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFDF9;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 200;
}

.driver-brief {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ebebeb;
}

.driver-avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border: 1rpx solid #ebebeb;
}

/* 司机头像内文字 */
.driver-avatar-text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.driver-name-sm {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  color: #111;
}

.driver-car-sm {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 2rpx;
}

.ride-progress {
  padding: 24rpx 0;
}

.progress-points {
  display: flex;
  flex-direction: column;
}

.progress-point {
  display: flex;
  align-items: center;
}

.pp-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-green { background: #34c759; }
.dot-dark { background: #111; }

.pp-text {
  font-size: 26rpx;
  color: #111;
  max-width: 500rpx;
}

.progress-line {
  margin-left: 5rpx;
  width: 2rpx;
  height: 40rpx;
  background: #ebebeb;
  position: relative;
}

.progress-fill {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: #111;
  border-radius: 1rpx;
  transition: height 0.5s;
}

.ride-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.ride-stat {
  text-align: center;
}

.rs-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: block;
}

.rs-value.price {
  color: #111;
}

.rs-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.finish-btn {
  margin-top: 16rpx;
}

@import 'riding-wxa-auto-dark.wxss'
