/* pages/waiting/waiting.wxss — 极简等待页 */
.page-waiting {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100vh;
}

.top-status {
  position: fixed;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border-radius: 8rpx;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #ebebeb;
  z-index: 100;
}

.status-badge {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.status-matching { background: #111; }
.status-matched { background: #34c759; }
.status-arriving { background: #34c759; }

.status-pulse {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #111;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.5); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}

.status-text {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
}

.wait-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
}

.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 200;
  max-height: 70vh;
  overflow-y: auto;
}

.matching-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.matching-animation {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pulse-ring {
  position: absolute;
  border: 2rpx solid #111;
  border-radius: 50%;
  opacity: 0;
  animation: pulseRing 2s infinite;
}

.ring-1 { width: 100rpx; height: 100rpx; animation-delay: 0s; }
.ring-2 { width: 130rpx; height: 130rpx; animation-delay: 0.4s; }
.ring-3 { width: 160rpx; height: 160rpx; animation-delay: 0.8s; }

@keyframes pulseRing {
  0% { transform: scale(0.5); opacity: 0.6; }
  100% { transform: scale(1); opacity: 0; }
}

/* CSS车辆图标 */
.matching-car {
  width: 32rpx;
  height: 20rpx;
  border: 3rpx solid #111;
  border-radius: 6rpx;
  position: relative;
  z-index: 1;
}
.matching-car::before,
.matching-car::after {
  content: "";
  position: absolute;
  bottom: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111;
}
.matching-car::before { left: 2rpx; }
.matching-car::after { right: 2rpx; }

.matching-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin-top: 24rpx;
  letter-spacing: 1rpx;
}

.matching-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.driver-section {
  padding-bottom: 20rpx;
}

.driver-card {
  background: #FAF8F5;
  border-radius: 8rpx;
  padding: 24rpx;
  border: 1rpx solid #EDE8E0;
}

.driver-top {
  display: flex;
  align-items: center;
}

.driver-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 1rpx solid #ebebeb;
}

.driver-avatar-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.driver-info { flex: 1; }

.driver-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: block;
}

.driver-rating {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.rating-num {
  font-size: 24rpx;
  color: #111;
  font-weight: 500;
}

.rating-trips {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.driver-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ebebeb;
}

/* CSS操作图标 */
.action-icon-view {
  width: 24rpx;
  height: 24rpx;
}
/* 电话 */
.ai-phone {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #111;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
/* 消息 */
.ai-msg {
  width: 20rpx;
  height: 16rpx;
  border: 2rpx solid #111;
  border-radius: 4rpx;
  position: relative;
}
.ai-msg::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  left: 3rpx;
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 5rpx solid #111;
}

.driver-car {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ebebeb;
}

.car-info {
  font-size: 26rpx;
  color: #666;
}

.trip-info {
  margin-top: 20rpx;
  padding: 24rpx;
}

.trip-point {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.trip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-green { background: #34c759; }
.dot-dark { background: #111; }

.trip-address {
  font-size: 28rpx;
  color: #111;
  max-width: 500rpx;
}

.trip-line {
  width: 1rpx;
  height: 16rpx;
  background: #ebebeb;
  margin-left: 5rpx;
}

.trip-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ebebeb;
}

.meta-car {
  font-size: 24rpx;
  color: #999;
}

.meta-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.action-section {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #666;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebebeb;
}

.cancel-btn::after { border: none; }

.ride-btn { flex: 1; }

/* 取消弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
  display: block;
  text-align: center;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
  text-align: center;
  margin-top: 8rpx;
}

.reason-list {
  margin-top: 24rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.reason-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #c7c7cc;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.radio-checked {
  border-color: #111;
  background: #111;
  position: relative;
}

.radio-checked::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
}

.reason-text {
  font-size: 28rpx;
  color: #111;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f7f7f7;
  color: #666;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
}

.modal-cancel::after { border: none; }

.modal-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #111;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
}

.modal-confirm::after { border: none; }

/* ========== 司机轻聊弹窗 ========== */
.chat-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chat-panel {
  width: 100%;
  max-width: 750rpx;
  background: #FFFDF9;
  border-radius: 24rpx 24rpx 0 0;
  height: 80vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #EDE8E0;
  background: #FFFDF9;
}

.chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.chat-avatar-text {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 500;
}

.chat-header-info {
  flex: 1;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
}

.chat-status {
  font-size: 22rpx;
  color: #8A8278;
  margin-top: 4rpx;
  display: block;
}

.chat-close {
  font-size: 28rpx;
  color: #C5B9A8;
  padding: 8rpx 12rpx;
}

.chat-body {
  flex: 1;
  padding: 24rpx 32rpx;
  background: #FAF8F5;
}

.chat-msg {
  display: flex;
  margin-bottom: 20rpx;
}

.chat-msg-driver {
  justify-content: flex-start;
}

.chat-msg-me {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 70%;
  background: #FFFDF9;
  border: 1rpx solid #EDE8E0;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #2D2A26;
  line-height: 1.5;
  word-break: break-all;
}

.chat-bubble-me {
  background: #2D2A26;
  color: #fff;
  border: none;
  border-radius: 12rpx 12rpx 4rpx 12rpx;
}

.chat-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 32rpx 24rpx;
  background: #FFFDF9;
  border-top: 1rpx solid #EDE8E0;
}

.chat-quick-item {
  padding: 12rpx 20rpx;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E0;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #2D2A26;
}

.chat-quick-item:active {
  background: #2D2A26;
  color: #fff;
}

@import 'waiting-wxa-auto-dark.wxss'
