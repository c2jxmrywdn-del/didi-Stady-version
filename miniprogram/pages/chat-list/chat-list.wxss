/* pages/chat-list/chat-list.wxss — 会话列表 */
.page-chat-list {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

/* 顶部 */
.chat-top {
  background: #FFFDF9;
  padding: 24rpx 32rpx 8rpx;
  border-bottom: 1rpx solid #EDE8E0;
  display: flex;
  align-items: baseline;
}
.chat-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D2A26;
  letter-spacing: 1rpx;
}
.chat-unread {
  font-size: 22rpx;
  color: #8A8278;
  margin-left: 16rpx;
}

/* 搜索 */
.chat-search {
  background: #FFFDF9;
  padding: 12rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #EDE8E0;
}
.chat-search-wrap {
  display: flex;
  align-items: center;
  background: #FAF8F5;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #EDE8E0;
}
.chat-search-icon {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #999;
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
}
.chat-search-icon::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  right: -5rpx;
  width: 7rpx;
  height: 2rpx;
  background: #999;
  transform: rotate(45deg);
}
.chat-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #111;
}

/* 客服入口 */
.service-entry {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 28rpx 24rpx;
  background: #FFFDF9;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
}
.service-entry:active {
  background: #f7f5f0;
}
.service-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2D2A26 0%, #5C554C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.mi-headset {
  width: 30rpx;
  height: 28rpx;
  border: 3rpx solid #FFFDF9;
  border-radius: 0 0 12rpx 12rpx;
  border-top: none;
  position: relative;
}
.mi-headset::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: -3rpx;
  width: 36rpx;
  height: 14rpx;
  border: 3rpx solid #FFFDF9;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}
.service-info {
  flex: 1;
  min-width: 0;
}
.service-name {
  font-size: 30rpx;
  color: #111;
  font-weight: 500;
  display: block;
}
.service-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.service-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 会话列表 */
.chat-list {
  margin: 0 24rpx;
  background: #FFFDF9;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  overflow: hidden;
}
.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f7f7f7;
  position: relative;
}
.chat-item:last-child {
  border-bottom: none;
}
.chat-item:active {
  background: #f7f5f0;
}
.chat-unread {
  background: #ffffff;
}
.chat-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.chat-avatar-emoji {
  font-size: 44rpx;
}
.chat-status-dot {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #5CAA5C;
  border: 2rpx solid #FFFDF9;
}
.chat-content {
  flex: 1;
  min-width: 0;
}
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.chat-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-time {
  font-size: 22rpx;
  color: #C5B9A8;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.chat-preview-row {
  margin-top: 6rpx;
  min-height: 36rpx;
}
.chat-preview {
  font-size: 26rpx;
  color: #5C554C;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-unread .chat-preview {
  color: #2D2A26;
  font-weight: 500;
}
.chat-subtitle {
  font-size: 22rpx;
  color: #C5B9A8;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-unread-badge {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F5F0E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-bubble {
  width: 64rpx;
  height: 48rpx;
  background: #C5B9A8;
  border-radius: 12rpx;
  position: relative;
}
.empty-bubble-tail {
  position: absolute;
  bottom: -8rpx;
  left: 14rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #C5B9A8;
}
.empty-text {
  font-size: 28rpx;
  color: #8A8278;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #C5B9A8;
}

/* 长按菜单 */
.action-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.action-card {
  background: #FFFDF9;
  width: 100%;
  border-radius: 16rpx 16rpx 0 0;
  padding: 32rpx 0 48rpx;
}
.action-title {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0ede8;
}
.action-item {
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #111;
  border-bottom: 1rpx solid #f7f7f7;
}
.action-item:active {
  background: #f7f5f0;
}
.action-danger {
  color: #e74c3c;
}
.action-cancel {
  margin-top: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  background: #FAF8F5;
  border-top: 6rpx solid #FFFDF9;
}
@import 'chat-list-wxa-auto-dark.wxss'
