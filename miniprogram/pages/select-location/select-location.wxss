/* pages/select-location/select-location.wxss — 极简选址页 */
.page-select-location {
  min-height: 100vh;
  background: #FAF8F5;
}

.search-bar {
  padding: 16rpx 24rpx;
  background: #FFFDF9;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #EDE8E0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #FAF8F5;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #EDE8E0;
}

/* CSS搜索图标 */
.search-icon-css {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #999;
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
}
.search-icon-css::after {
  content: "";
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 8rpx;
  height: 2rpx;
  background: #999;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

.quick-actions {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #EDE8E0;
}

.quick-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  border: 1rpx solid #ebebeb;
}

/* CSS快捷图标 */
.qa-icon-css {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}
.qa-locate {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #111;
  border-radius: 50%;
  position: relative;
}
.qa-locate::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-top: 5rpx solid #111;
}
.qa-map {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #111;
  border-radius: 2rpx;
  position: relative;
}
.qa-map::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  border: 2rpx solid #111;
}

.qa-text {
  font-size: 26rpx;
  color: #111;
}

.section {
  padding: 0 24rpx;
  border-bottom: 1rpx solid #EDE8E0;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0 8rpx;
  display: block;
  letter-spacing: 1rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.location-item:last-child {
  border-bottom: none;
}

.location-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid #ebebeb;
}

/* CSS地点类型图标 */
.li-home {
  width: 16rpx;
  height: 12rpx;
  border: 2rpx solid #111;
  border-top: none;
  position: relative;
}
.li-home::before {
  content: "";
  position: absolute;
  top: -8rpx;
  left: -2rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 8rpx solid #111;
}
.li-office {
  width: 16rpx;
  height: 20rpx;
  border: 2rpx solid #111;
  position: relative;
}
.li-office::before {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 3rpx;
  width: 4rpx;
  height: 4rpx;
  background: #111;
  box-shadow: 6rpx 0 0 #111, 0 6rpx 0 #111, 6rpx 6rpx 0 #111;
}
.li-hot {
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #111;
  transform: rotate(45deg);
}
.li-pin {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #111;
  border-radius: 50%;
  position: relative;
}
.li-pin::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-top: 5rpx solid #111;
}

.location-info {
  flex: 1;
  min-width: 0;
}

.location-name {
  font-size: 28rpx;
  color: #111;
  display: block;
}

.location-address {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-distance {
  font-size: 24rpx;
  color: #c7c7cc;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 搜索中加载提示 */
.searching-tip {
  text-align: center;
  padding: 40rpx 0;
}
.searching-text {
  font-size: 26rpx;
  color: #999;
}

/* 搜索结果右侧标签+距离 */
.location-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.location-tag {
  font-size: 22rpx;
  color: #aaa;
  margin-bottom: 4rpx;
}
@import 'select-location-wxa-auto-dark.wxss'
