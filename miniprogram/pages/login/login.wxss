/* pages/login/login.wxss — 登录页(类滴滴出行 UI) */
.page-login {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFDF9 0%, #FAF8F5 100%);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 40rpx;
  box-sizing: border-box;
}

/* ============ 品牌区 ============ */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  margin-bottom: 56rpx;
}
.brand-logo {
  margin-bottom: 24rpx;
}
.brand-logo-bg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF7B00 0%, #FF5500 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 123, 0, 0.25);
  position: relative;
}
.brand-logo-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 50%);
  pointer-events: none;
}
.brand-logo-text {
  font-size: 72rpx;
  line-height: 1;
}
.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  letter-spacing: 4rpx;
}
.brand-slogan {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* ============ 登录卡片 ============ */
.login-card {
  background: transparent;
}

/* 微信一键登录(大绿按钮) */
.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  position: relative;
  overflow: hidden;
}
.wechat-btn::after {
  border: none;
}
.wechat-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}
.wechat-btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.wechat-icon-svg {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 12rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wechat-icon-shape {
  width: 28rpx;
  height: 22rpx;
  background: #07C160;
  border-radius: 6rpx 6rpx 4rpx 4rpx;
  position: relative;
}
.wechat-icon-shape::after {
  content: "";
  position: absolute;
  bottom: -4rpx;
  left: 2rpx;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 4rpx solid #07C160;
}
.wechat-icon-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
}
.wechat-icon-dot-1 {
  top: 16rpx;
  left: 18rpx;
}
.wechat-icon-dot-2 {
  bottom: 16rpx;
  right: 18rpx;
}
.wechat-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 分隔线 */
.divider-row {
  display: flex;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: #ebebeb;
}
.divider-text {
  font-size: 24rpx;
  color: #c7c7cc;
  padding: 0 24rpx;
  letter-spacing: 1rpx;
}

/* ============ 表单 ============ */
.form-section {
  width: 100%;
}

/* TDesign t-input 外层 + 验证码按钮组合 */
.input-group-wrapper {
  position: relative;
}
.input-group-wrapper .send-code {
  position: absolute;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #FF7B00;
  font-weight: 500;
  padding: 8rpx 16rpx;
  letter-spacing: 0.5rpx;
  z-index: 1;
}
.input-group-wrapper .send-code.code-disabled {
  color: #C5B9A8;
}

.input-group {
  display: flex;
  align-items: center;
  background: #FFFDF9;
  border: 2rpx solid #ede8e0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  transition: border-color 0.2s;
}
.input-group:focus-within {
  border-color: #FF7B00;
  background: #fff;
}
.input-prefix-wrap {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
  margin-right: 20rpx;
  border-right: 2rpx solid #f0ede8;
  min-width: 84rpx;
}
.input-prefix {
  font-size: 30rpx;
  color: #111;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.input-prefix-emoji {
  font-size: 28rpx;
}
.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #111;
  height: 96rpx;
  letter-spacing: 1rpx;
}
.input-field::placeholder {
  color: #c7c7cc;
  letter-spacing: 1rpx;
}
.input-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #c7c7cc;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

.send-code {
  font-size: 28rpx;
  color: #FF7B00;
  white-space: nowrap;
  padding-left: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.code-disabled {
  color: #c7c7cc;
}

/* 协议 */
.agreement-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0 24rpx;
}
.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #c7c7cc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  background: #FFFDF9;
}
.agreement-check.checked {
  background: #FF7B00;
  border-color: #FF7B00;
}
.agreement-check-mark {
  width: 12rpx;
  height: 6rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(2rpx, -2rpx);
}
.agreement-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  flex: 1;
}
.agreement-link {
  color: #FF7B00;
  font-weight: 500;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: #f0ede8;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  border: none;
  padding: 0;
  margin-top: 8rpx;
  transition: all 0.2s;
}
.login-btn::after {
  border: none;
}
.login-btn-active {
  background: linear-gradient(135deg, #FF7B00 0%, #FF5500 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 123, 0, 0.25);
}
.login-btn-active:active {
  opacity: 0.92;
  transform: scale(0.98);
}
.login-btn[disabled] {
  background: #f0ede8;
  color: #c7c7cc;
}

/* ============ 底部 ============ */
.bottom-section {
  margin-top: auto;
  padding-top: 40rpx;
}

.login-foot {
  text-align: center;
  padding: 24rpx 0 0;
}
.login-foot text {
  font-size: 22rpx;
  color: #C5B9A8;
  letter-spacing: 1rpx;
}
.login-foot-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 12rpx;
  gap: 4rpx;
}
.login-foot-link {
  font-size: 22rpx;
  color: #C5B9A8;
  padding: 4rpx 12rpx;
}
.login-foot-link:active {
  color: #FF7B00;
}
.login-foot-divider {
  font-size: 22rpx;
  color: #E0DCD6;
  line-height: 1;
}

/* ============ TDesign 风格:微信用户信息预览卡 ============ */
.profile-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #FFFDF9 0%, #FAF8F5 100%);
  border: 1rpx solid #EDE8E0;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 123, 0, 0.08);
  animation: profileIn 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
@keyframes profileIn {
  from { opacity: 0; transform: translateY(20rpx) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.profile-card-head {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #EDE8E0;
  margin-bottom: 24rpx;
}
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF7B00 0%, #E55A00 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 123, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  overflow: hidden;
}
.profile-avatar-fallback {
  background: linear-gradient(135deg, #FF7B00 0%, #E55A00 100%);
  color: #fff;
}
.profile-head-info {
  flex: 1;
  min-width: 0;
}
.profile-nick {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-tip {
  font-size: 22rpx;
  color: #8A8278;
  letter-spacing: 0.3rpx;
  display: block;
}

.profile-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx 24rpx;
}
.profile-field {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.profile-field-label {
  font-size: 22rpx;
  color: #999;
  letter-spacing: 0.5rpx;
}
.profile-field-value {
  font-size: 26rpx;
  color: #2D2A26;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}
.profile-field-value-strong {
  color: #FF7B00;
  font-weight: 600;
}

/* ============ 授权说明(未拿到信息时显示) ============ */
.permission-hint {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: rgba(255, 123, 0, 0.04);
  border: 1rpx dashed rgba(255, 123, 0, 0.25);
  border-radius: 16rpx;
}
.permission-hint-title {
  font-size: 24rpx;
  color: #FF7B00;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: block;
  margin-bottom: 14rpx;
}
.permission-hint-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.permission-hint-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #5C554C;
  letter-spacing: 0.3rpx;
}
.permission-hint-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FF7B00;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(255, 123, 0, 0.15);
}

/* ============ 微信按钮加强样式(TDesign) ============ */
.wechat-btn {
  position: relative;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
}
.wechat-btn-icon {
  margin-right: 0;
  margin-bottom: 6rpx;
}
.wechat-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  line-height: 1.2;
}
.wechat-btn-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
  margin-top: 4rpx;
  font-weight: 400;
}
.wechat-btn-active {
  background: linear-gradient(135deg, #FF7B00 0%, #FF5500 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 123, 0, 0.3);
}
.wechat-btn-disabled {
  background: linear-gradient(135deg, #C5B9A8 0%, #A8A092 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.wechat-btn-hover {
  opacity: 0.92;
  transform: scale(0.985);
}
.wechat-btn-disabled .wechat-btn-sub {
  color: rgba(255, 255, 255, 0.55);
}

/* ============ 手机号登录按钮(弱化样式) ============ */
.login-btn-disabled {
  background: #f0ede8;
  color: #c7c7cc;
  box-shadow: none;
}

@import 'login-wxa-auto-dark.wxss'
