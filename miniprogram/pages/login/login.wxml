<!-- pages/login/login.wxml — 登录页(TDesign 风格) -->
<view class="page-login">
  <!-- 顶部品牌区 -->
  <view class="brand-section">
    <view class="brand-logo">
      <view class="brand-logo-bg">
        <text class="brand-logo-text">🚗</text>
      </view>
    </view>
    <text class="brand-name">滴滴学习版</text>
    <text class="brand-slogan">出行更美好 · 学习更高效</text>
  </view>

  <!-- 微信用户信息预览卡(拿到信息后展示;空时占位) -->
  <view wx:if="{{wechatProfile}}" class="profile-card md-card md-elev-2">
    <view class="profile-card-head">
      <image
        wx:if="{{wechatProfile.avatarUrl}}"
        class="profile-avatar"
        src="{{wechatProfile.avatarUrl}}"
        mode="aspectFill"
        binderror="onProfileAvatarError"
      />
      <view wx:else class="profile-avatar profile-avatar-fallback">{{wechatProfile.nickName[0] || '微'}}</view>
      <view class="profile-head-info">
        <text class="profile-nick">{{wechatProfile.nickName}}</text>
        <text class="profile-tip">已获取以下信息(可继续授权手机号)</text>
      </view>
    </view>
    <view class="profile-fields">
      <view class="profile-field">
        <text class="profile-field-label">性别</text>
        <text class="profile-field-value">{{wechatProfile.gender === 1 ? '男' : wechatProfile.gender === 2 ? '女' : '未知'}}</text>
      </view>
      <view class="profile-field">
        <text class="profile-field-label">国家</text>
        <text class="profile-field-value">{{wechatProfile.country || '-'}}</text>
      </view>
      <view class="profile-field">
        <text class="profile-field-label">省份</text>
        <text class="profile-field-value">{{wechatProfile.province || '-'}}</text>
      </view>
      <view class="profile-field">
        <text class="profile-field-label">城市</text>
        <text class="profile-field-value">{{wechatProfile.city || '-'}}</text>
      </view>
      <view wx:if="{{phoneMasked}}" class="profile-field">
        <text class="profile-field-label">手机号</text>
        <text class="profile-field-value profile-field-value-strong">{{phoneMasked}}</text>
      </view>
    </view>
  </view>

  <!-- 授权说明(空时显示) -->
  <view wx:else class="permission-hint">
    <text class="permission-hint-title">登录将获取</text>
    <view class="permission-hint-list">
      <view class="permission-hint-item">
        <view class="permission-hint-dot"></view>
        <text>微信头像与昵称</text>
      </view>
      <view class="permission-hint-item">
        <view class="permission-hint-dot"></view>
        <text>性别 / 城市 / 省份 / 国家</text>
      </view>
      <view class="permission-hint-item">
        <view class="permission-hint-dot"></view>
        <text>微信绑定的手机号(用于订单通知与安全登录)</text>
      </view>
    </view>
  </view>

  <!-- 主登录区 -->
  <view class="login-card">
    <!-- 微信一键登录(主操作,橙色高亮) -->
    <button
      class="wechat-btn {{agreed ? 'wechat-btn-active' : 'wechat-btn-disabled'}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      bindtap="onWechatQuickLogin"
      hover-class="wechat-btn-hover"
      hover-stay-time="80"
    >
      <view class="wechat-btn-icon">
        <view class="wechat-icon-svg">
          <view class="wechat-icon-shape"></view>
          <view class="wechat-icon-dot wechat-icon-dot-1"></view>
          <view class="wechat-icon-dot wechat-icon-dot-2"></view>
        </view>
      </view>
      <text class="wechat-btn-text">微信一键登录</text>
      <text class="wechat-btn-sub">获取头像 · 昵称 · 手机号</text>
    </button>

    <!-- 分隔线 (TDesign) -->
    <t-divider content="其他登录方式" align="center" />

    <!-- 手机号登录(次操作) -->
    <view class="form-section">
      <!-- 手机号输入 (TDesign t-input) -->
      <t-input
        label="+86 手机号"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        clearable
        value="{{phone}}"
        bind:change="onPhoneInput"
      />

      <!-- 验证码输入 (TDesign t-input,自定义右侧操作) -->
      <view class="input-group-wrapper">
        <t-input
          label="验证码"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          value="{{code}}"
          bind:change="onCodeInput"
        />
        <text
          class="send-code {{countdown > 0 ? 'code-disabled' : ''}}"
          bindtap="onSendCode"
        >
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </text>
      </view>

      <!-- 协议 -->
      <view class="agreement-row">
        <view class="agreement-check {{agreed ? 'checked' : ''}}" bindtap="onAgreement">
          <view wx:if="{{agreed}}" class="agreement-check-mark"></view>
        </view>
        <text class="agreement-text">
          我已阅读并同意
          <text class="agreement-link" bindtap="onViewAgreement">《用户协议》</text>
          和
          <text class="agreement-link" bindtap="onViewPrivacy">《隐私政策》</text>
        </text>
      </view>

      <!-- 登录按钮 (TDesign t-button) -->
      <t-button
        theme="primary"
        size="large"
        block
        disabled="{{!agreed || phone.length !== 11 || code.length < 4}}"
        bind:tap="onLogin"
      >
        手机号登录
      </t-button>
    </view>
  </view>

  <!-- 底部 -->
  <view class="bottom-section">
    <view class="login-foot">
      <text>登录即表示您同意我们的服务条款</text>
      <view class="login-foot-links">
        <text class="login-foot-link" bindtap="onViewAgreement">用户协议</text>
        <text class="login-foot-divider">|</text>
        <text class="login-foot-link" bindtap="onViewPrivacy">隐私政策</text>
        <text class="login-foot-divider">|</text>
        <text class="login-foot-link" bindtap="onContact">联系客服</text>
      </view>
    </view>
  </view>

  <!-- TDesign 组件 -->
  <t-message id="t-message" />
  <t-dialog id="t-dialog" />
</view>
