/* pages/change-password/change-password.wxss — TDesign 风格 */
.page-cp {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ============ 顶部说明卡 ============ */
.cp-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #F5F5F7 100%);
  text-align: center;
}
.cp-hero-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF7B00 0%, #FF5500 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 123, 0, 0.25);
}
.cp-mi-lock-big {
  width: 50rpx;
  height: 44rpx;
  border: 4rpx solid #fff;
  border-radius: 6rpx 6rpx 8rpx 8rpx;
  position: relative;
  margin-top: 8rpx;
}
.cp-mi-lock-big::before {
  content: "";
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 26rpx;
  border: 4rpx solid #fff;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}
.cp-mi-lock-big::after {
  content: "";
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 50%;
}
.cp-hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #2D2A26;
  letter-spacing: 1rpx;
}
.cp-hero-sub {
  font-size: 24rpx;
  color: #8A8278;
  margin-top: 12rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.5;
  padding: 0 32rpx;
}

/* ============ 表单 ============ */
.cp-form {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cp-field {
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F2;
}
.cp-field:last-of-type { border-bottom: none; }
.cp-field-label {
  display: block;
  font-size: 26rpx;
  color: #5C554C;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  margin-bottom: 16rpx;
}
.cp-field-row {
  display: flex;
  align-items: center;
  height: 64rpx;
}
.cp-field-input {
  flex: 1;
  font-size: 30rpx;
  color: #2D2A26;
  height: 64rpx;
  letter-spacing: 1rpx;
  min-width: 0;
}
.cp-ph {
  color: #C5B9A8;
  font-size: 28rpx;
  letter-spacing: 0.3rpx;
}
.cp-field-eye {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}
.cp-mi-eye {
  width: 32rpx;
  height: 22rpx;
  border: 2rpx solid #8A8278;
  border-radius: 50% / 60%;
  position: relative;
  background: transparent;
}
.c-mi-eye, .cp-mi-eye {
  transition: all 0.2s;
}
.cp-eye-open {
  border-color: #FF7B00;
}
.cp-mi-eye::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: #8A8278;
  border-radius: 50%;
}
.cp-eye-open::before { background: #FF7B00; }
.cp-mi-eye::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(35deg);
  width: 4rpx;
  height: 24rpx;
  background: #8A8278;
  border-radius: 2rpx;
  opacity: 0;
}
.cp-eye-open::after { opacity: 0; }
.cp-eye-close::after { opacity: 1; }

/* 强度条 */
.cp-strength {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 16rpx;
}
.cp-strength-bar {
  flex: 1;
  height: 8rpx;
  background: #F0F0F2;
  border-radius: 4rpx;
  overflow: hidden;
}
.cp-strength-fill {
  height: 100%;
  border-radius: 4rpx;
  width: var(--pct, 0%);
  background: var(--bar-color, #C5B9A8);
  transition: width 0.3s, background 0.3s;
}
.cp-strength-label {
  font-size: 22rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
  font-weight: 500;
}

/* 提示行 */
.cp-field-tips {
  padding: 0 24rpx 16rpx;
  text-align: right;
}
.cp-tip-link {
  font-size: 24rpx;
  color: #FF7B00;
  letter-spacing: 0.5rpx;
}
.cp-tip-link:active { opacity: 0.7; }

.cp-field-feedback {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.cp-feedback-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.cp-feedback-ok { background: rgba(92, 170, 92, 0.12); color: #5CAA5C; }
.cp-feedback-err { background: rgba(231, 76, 60, 0.12); color: #E74C3C; }
.cp-feedback-letter {
  font-size: 18rpx;
  font-weight: bold;
  line-height: 1;
}
.cp-feedback-text {
  font-size: 22rpx;
  letter-spacing: 0.3rpx;
}

/* 推荐密码 */
.cp-suggestion {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(90deg, rgba(255, 123, 0, 0.06) 0%, rgba(255, 123, 0, 0.02) 100%);
  border-top: 1rpx solid #F0F0F2;
}
.cp-suggestion:active { background: linear-gradient(90deg, rgba(255, 123, 0, 0.12) 0%, rgba(255, 123, 0, 0.06) 100%); }
.cp-suggestion-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF7B00 0%, #FFB300 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cp-mi-magic {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}
.cp-mi-magic::before {
  content: "✦";
  position: absolute;
  top: 0;
  left: 0;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}
.cp-mi-magic::after {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 4rpx;
  width: 6rpx;
  height: 6rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: -8rpx 4rpx 0 #fff, -4rpx -8rpx 0 #fff;
}
.cp-suggestion-text {
  flex: 1;
  min-width: 0;
}
.cp-suggestion-title {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 500;
  display: block;
}
.cp-suggestion-sub {
  font-size: 22rpx;
  color: #8A8278;
  display: block;
  margin-top: 4rpx;
}
.cp-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  margin-left: 8rpx;
  font-weight: 300;
  line-height: 1;
}

/* ============ 安全提示 ============ */
.cp-tips {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cp-tips-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #2D2A26;
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}
.cp-mi-tip {
  width: 8rpx;
  height: 8rpx;
  background: #FF7B00;
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
}
.cp-mi-tip::before {
  content: "";
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 123, 0, 0.25);
}
.cp-tips-item {
  font-size: 24rpx;
  color: #5C554C;
  line-height: 1.8;
  letter-spacing: 0.3rpx;
}

/* ============ 提交按钮 ============ */
.cp-submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}
.cp-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #E0E0E2;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
  border: none;
  padding: 0;
  transition: background 0.2s;
}
.cp-submit::after { border: none; }
.cp-submit-active {
  background: linear-gradient(135deg, #FF7B00 0%, #FF5500 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 123, 0, 0.32);
}
.cp-submit-active:active {
  background: linear-gradient(135deg, #E56F00 0%, #E54E00 100%);
}
.cp-submit-hover { opacity: 0.92; }

/* ============ 成功动画层 ============ */
.cp-success-mask {
  position: fixed;
  inset: 0;
  background: rgba(45, 42, 38, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cpMaskIn 220ms ease both;
}
@keyframes cpMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.cp-success-card {
  width: 360rpx;
  padding: 48rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: cpSuccessIn 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
@keyframes cpSuccessIn {
  from { opacity: 0; transform: scale(0.7); }
  to { opacity: 1; transform: scale(1); }
}
.cp-success-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5CAA5C 0%, #4A8A4A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(92, 170, 92, 0.32);
  animation: cpSuccessScale 480ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
@keyframes cpSuccessScale {
  0%   { transform: scale(0); }
  60%  { transform: scale(1.18); }
  100% { transform: scale(1); }
}
.cp-success-check {
  color: #fff;
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
}
.cp-success-title {
  font-size: 32rpx;
  color: #2D2A26;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ============ Toast ============ */
.cp-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(45, 42, 38, 0.92);
  color: #fff;
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  z-index: 1000;
  letter-spacing: 0.5rpx;
  animation: cpToastIn 200ms ease both;
  max-width: 80vw;
  text-align: center;
  line-height: 1.5;
}
@keyframes cpToastIn {
  from { opacity: 0; transform: translate(-50%, -45%); }
  to { opacity: 1; transform: translate(-50%, -50%); }
}
