<!-- pages/change-password/change-password.wxml — TDesign 风格 -->
<view class="page-cp page-enter">
  <!-- 顶部说明卡 -->
  <view class="cp-hero">
    <view class="cp-hero-icon">
      <view class="cp-mi-lock-big"></view>
    </view>
    <text class="cp-hero-title">{{pageTitle}}</text>
    <text class="cp-hero-sub">{{isFirstSet ? '为了账号安全,请设置一个强密码' : '建议每 3-6 个月更换一次密码,保护账号安全'}}</text>
  </view>

  <!-- 密码表单 -->
  <view class="cp-form">
    <!-- 原密码(非首次设置时) -->
    <block wx:if="{{!isFirstSet}}">
      <view class="cp-field">
        <text class="cp-field-label">原密码</text>
        <view class="cp-field-row">
          <input
            class="cp-field-input"
            type="{{showPwd.current ? 'text' : 'password'}}"
            password="{{!showPwd.current}}"
            value="{{form.current}}"
            data-field="current"
            bindinput="onInput"
            bindfocus="onPwdFocus"
            placeholder="请输入原密码"
            placeholder-class="cp-ph"
            maxlength="40"
          />
          <view class="cp-field-eye" data-field="current" bindtap="togglePwd">
            <view class="cp-mi-eye {{showPwd.current ? 'cp-eye-open' : 'cp-eye-close'}}"></view>
          </view>
        </view>
      </view>
      <view class="cp-field-tips">
        <text class="cp-tip-link" bindtap="onForgotPwd">忘记原密码?</text>
      </view>
    </block>

    <!-- 新密码 -->
    <view class="cp-field">
      <text class="cp-field-label">{{isFirstSet ? '设置密码' : '新密码'}}</text>
      <view class="cp-field-row">
        <input
          class="cp-field-input"
          type="{{showPwd.next ? 'text' : 'password'}}"
          password="{{!showPwd.next}}"
          value="{{form.next}}"
          data-field="next"
          bindinput="onInput"
          bindfocus="onPwdFocus"
          placeholder="{{PWD_MIN_LEN}}-{{PWD_MAX_LEN}} 位,含字母与数字"
          placeholder-class="cp-ph"
          maxlength="40"
        />
        <view class="cp-field-eye" data-field="next" bindtap="togglePwd">
          <view class="cp-mi-eye {{showPwd.next ? 'cp-eye-open' : 'cp-eye-close'}}"></view>
        </view>
      </view>
      <!-- 强度条 -->
      <view class="cp-strength" wx:if="{{form.next.length > 0}}">
        <view class="cp-strength-bar">
          <view class="cp-strength-fill" style="--pct: {{currentStrength.pct}}%; --bar-color: {{currentStrength.color}};"></view>
        </view>
        <text class="cp-strength-label" style="color: {{currentStrength.color}};">强度:{{currentStrength.label}}</text>
      </view>
    </view>

    <!-- 确认密码 -->
    <view class="cp-field">
      <text class="cp-field-label">确认密码</text>
      <view class="cp-field-row">
        <input
          class="cp-field-input"
          type="{{showPwd.confirm ? 'text' : 'password'}}"
          password="{{!showPwd.confirm}}"
          value="{{form.confirm}}"
          data-field="confirm"
          bindinput="onInput"
          bindfocus="onPwdFocus"
          placeholder="再次输入新密码"
          placeholder-class="cp-ph"
          maxlength="40"
        />
        <view class="cp-field-eye" data-field="confirm" bindtap="togglePwd">
          <view class="cp-mi-eye {{showPwd.confirm ? 'cp-eye-open' : 'cp-eye-close'}}"></view>
        </view>
      </view>
      <view wx:if="{{confirmTouched && form.confirm.length > 0}}" class="cp-field-feedback">
        <view class="cp-feedback-icon {{confirmMatched ? 'cp-feedback-ok' : 'cp-feedback-err'}}">
          <text class="cp-feedback-letter">{{confirmMatched ? '✓' : '✕'}}</text>
        </view>
        <text class="cp-feedback-text {{confirmMatched ? 'cp-feedback-ok' : 'cp-feedback-err'}}">
          {{confirmMatched ? '两次密码一致' : '两次密码不一致'}}
        </text>
      </view>
    </view>

    <!-- 推荐密码(快速填充) -->
    <view wx:if="{{!isFirstSet}}" class="cp-suggestion" bindtap="onSuggestionTap">
      <view class="cp-suggestion-icon">
        <view class="cp-mi-magic"></view>
      </view>
      <view class="cp-suggestion-text">
        <text class="cp-suggestion-title">使用推荐强密码</text>
        <text class="cp-suggestion-sub">点击自动填入一个安全密码(可继续修改)</text>
      </view>
      <text class="cp-arrow">›</text>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="cp-tips">
    <view class="cp-tips-title">
      <view class="cp-mi-tip"></view>
      <text>密码安全建议</text>
    </view>
    <view class="cp-tips-item">· 长度 8-20 位,推荐 12 位以上</view>
    <view class="cp-tips-item">· 同时包含大小写字母、数字、特殊字符</view>
    <view class="cp-tips-item">· 不要使用生日、手机号、连续数字等弱密码</view>
    <view class="cp-tips-item">· 不同网站使用不同密码,定期更换</view>
  </view>

  <!-- 提交按钮 -->
  <view class="cp-submit-bar">
    <button
      class="cp-submit {{canSubmit && !submitting ? 'cp-submit-active' : ''}}"
      bindtap="onSubmit"
      disabled="{{!canSubmit || submitting}}"
      hover-class="cp-submit-hover"
    >
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>{{isFirstSet ? '设置密码' : '确认修改'}}</text>
    </button>
  </view>

  <!-- 成功动画层 -->
  <view wx:if="{{showSuccess}}" class="cp-success-mask">
    <view class="cp-success-card">
      <view class="cp-success-circle">
        <view class="cp-success-check">✓</view>
      </view>
      <text class="cp-success-title">{{isFirstSet ? '密码已设置' : '密码已更新'}}</text>
    </view>
  </view>

  <!-- Toast -->
  <view wx:if="{{showToast}}" class="cp-toast">{{toastText}}</view>

  <!-- TDesign 组件 -->
  <t-message id="t-message" />
  <t-dialog id="t-dialog" />
</view>
