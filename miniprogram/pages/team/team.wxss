/* pages/team/team.wxss — 开发团队完整展示页
   风格:与 about 页统一(Material elevation、暖白底、深棕文字)
   关键差异:team 页只多了一个顶部品牌色 banner,其余视觉与 about 卡片风格一致 */
.page-team {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 80rpx;
}

/* ============ 顶部 Banner(暖白 + 橙色装饰,保持 about 风格统一) ============ */
.team-banner {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #FFFDF9 0%, #F5F0E8 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #EDE8E0;
  padding-top: 0; /* 系统导航栏由 wx 渲染,无需自留空间 */
}
.team-banner-deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.banner-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.banner-circle-1 {
  width: 320rpx;
  height: 320rpx;
  top: -120rpx;
  right: -80rpx;
}
.banner-circle-2 {
  width: 220rpx;
  height: 220rpx;
  bottom: -60rpx;
  left: -40rpx;
  background: rgba(255, 123, 0, 0.12);
}
.banner-circle-3 {
  width: 140rpx;
  height: 140rpx;
  top: 60rpx;
  left: 60%;
  background: rgba(255, 255, 255, 0.08);
}

.team-banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
}
.team-banner-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(255, 123, 0, 0.18));
}
.team-banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D2A26;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}
.team-banner-subtitle {
  font-size: 22rpx;
  color: #8A8278;
  letter-spacing: 1rpx;
}

/* ============ 团队统计 ============ */
.team-stats {
  display: flex;
  background: #FFFDF9;
  margin: -40rpx 24rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid #EDE8E0;
  padding: 28rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}
.team-stat-item {
  flex: 1;
  text-align: center;
}
.team-stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #EDE8E0;
  margin: auto 0;
}
.team-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D2A26;
  display: block;
  letter-spacing: 0.5rpx;
}
.team-stat-label {
  font-size: 22rpx;
  color: #8A8278;
  display: block;
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}

/* ============ 通用 section ============ */
.section {
  background: #FFFDF9;
  margin: 16rpx 12rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid #EDE8E0;
  overflow: hidden;
}
.section-title {
  font-size: 22rpx;
  color: #999;
  padding: 24rpx 24rpx 12rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}

/* ============ 成员 Hero 卡片 ============ */
.member-block {
  padding: 24rpx;
  border-bottom: 1rpx solid #F2EEE7;
}
.member-block:last-child {
  border-bottom: none;
}

.member-hero {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #F2EEE7;
}
.member-hero-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7B00 0%, #E55A00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255, 123, 0, 0.2);
}
.member-hero-info {
  flex: 1;
  min-width: 0;
}
.member-hero-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.member-hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-right: 16rpx;
  letter-spacing: 0.5rpx;
}
.member-hero-role {
  font-size: 22rpx;
  color: #FF7B00;
  background: rgba(255, 123, 0, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  border: 1rpx solid rgba(255, 123, 0, 0.15);
}
.member-hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.member-tag {
  font-size: 20rpx;
  color: #5C554C;
  background: #FAF8F5;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EDE8E0;
  letter-spacing: 0.3rpx;
}

.member-bio {
  font-size: 26rpx;
  color: #5C554C;
  line-height: 1.7;
  letter-spacing: 0.3rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #F2EEE7;
}

/* ============ 成员 meta 信息 ============ */
.member-meta {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2EEE7;
}
.member-meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.member-meta-label {
  font-size: 20rpx;
  color: #999;
  letter-spacing: 0.5rpx;
}
.member-meta-value {
  font-size: 26rpx;
  color: #2D2A26;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

/* ============ 联系方式列表 ============ */
.member-contacts {
  padding-top: 16rpx;
}
.member-contacts-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 16rpx;
}
.member-contacts-title {
  font-size: 24rpx;
  color: #2D2A26;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: center;
}
.member-contacts-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 22rpx;
  background: #FF7B00;
  border-radius: 3rpx;
  margin-right: 10rpx;
}
.member-contacts-hint {
  font-size: 20rpx;
  color: #C5B9A8;
  background: #FAF8F5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid #EDE8E0;
  letter-spacing: 0.5rpx;
}

.member-social-row {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  background: #FAF8F5;
  border: 1rpx solid #F2EEE7;
  transition: transform 0.12s, background 0.12s;
}
.member-social-row:last-of-type {
  margin-bottom: 0;
}
.member-social-row-hover {
  background: #F2EEE7;
  transform: scale(0.99);
}
.member-social-row:active {
  background: #F2EEE7;
  transform: scale(0.99);
}
.member-social-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}
.member-social-icon text {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}
.member-social-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.member-social-name {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  display: block;
  margin-bottom: 4rpx;
}
.member-social-handle {
  font-size: 22rpx;
  color: #8A8278;
  letter-spacing: 0.3rpx;
  display: block;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
}
.member-social-arrow {
  font-size: 32rpx;
  color: #C5B9A8;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.member-copy-all {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FF7B00 0%, #E55A00 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 123, 0, 0.2);
}
.member-copy-all:active { opacity: 0.85; }
.copy-all-arrow {
  font-size: 28rpx;
  margin-left: 10rpx;
}

/* ============ 里程碑 ============ */
.milestone-list {
  padding: 0 24rpx 24rpx;
  position: relative;
}
.milestone-list::before {
  content: "";
  position: absolute;
  left: 36rpx;
  top: 12rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #FF7B00 0%, #EDE8E0 100%);
}
.milestone-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  position: relative;
}
.milestone-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #FF7B00;
  border: 4rpx solid #FFFDF9;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 2rpx #FF7B00;
  z-index: 1;
}
.milestone-content {
  flex: 1;
  min-width: 0;
}
.milestone-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}
.milestone-date {
  font-size: 22rpx;
  color: #FF7B00;
  font-weight: 600;
  margin-right: 12rpx;
  letter-spacing: 0.5rpx;
  background: rgba(255, 123, 0, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.milestone-title {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.milestone-desc {
  font-size: 24rpx;
  color: #8A8278;
  letter-spacing: 0.3rpx;
  line-height: 1.6;
  display: block;
}

/* ============ 声明 ============ */
.team-declare {
  margin: 32rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #FFFDF9 0%, #FAF8F5 100%);
  border-radius: 16rpx;
  border: 1rpx solid #EDE8E0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.declare-title {
  font-size: 26rpx;
  color: #2D2A26;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.declare-line {
  font-size: 22rpx;
  color: #8A8278;
  letter-spacing: 0.5rpx;
  line-height: 1.7;
}
@import 'team-wxa-auto-dark.wxss'
