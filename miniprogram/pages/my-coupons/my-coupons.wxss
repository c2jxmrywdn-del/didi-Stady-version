/* pages/my-coupons/my-coupons.wxss */
.page-my-coupons {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 60rpx;
}

/* 标签栏 */
.coupons-tabs {
  display: flex;
  background: #FFFDF9;
  border-bottom: 1rpx solid #EDE8E0;
  position: sticky;
  top: 0;
  z-index: 10;
}
.coupons-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #8A8278;
  position: relative;
}
.coupons-tab-active {
  color: #2D2A26;
  font-weight: 600;
}
.coupons-tab-active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2D2A26;
  border-radius: 2rpx;
}
.coupons-tab-count {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  box-sizing: border-box;
}

/* 优惠卷列表 */
.coupons-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.coupon-item {
  display: flex;
  background: linear-gradient(90deg, #FFFDF9 60%, #FAF8F5 100%);
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  overflow: hidden;
  position: relative;
}
.coupon-item.coupon-used {
  background: #FAF8F5;
  opacity: 0.6;
}
.coupon-item.coupon-expired {
  background: #FAF8F5;
  opacity: 0.5;
}

/* 左侧 */
.coupon-left {
  width: 220rpx;
  background: linear-gradient(135deg, #e7a85f 0%, #d89348 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}
.coupon-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.coupon-currency {
  font-size: 30rpx;
  margin-bottom: 6rpx;
}
.coupon-num {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1;
}
.coupon-discount {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1;
}
.coupon-discount-text {
  font-size: 30rpx;
  margin-left: 2rpx;
}
.coupon-condition {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  letter-spacing: 1rpx;
}

/* 分割虚线 */
.coupon-divider {
  position: relative;
  width: 24rpx;
  background: transparent;
}
.coupon-divider-line {
  position: absolute;
  top: 16rpx;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 1rpx;
  border-left: 2rpx dashed #C5B9A8;
}
.coupon-divider-circle {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #FAF8F5;
  border-radius: 50%;
}
.coupon-divider-top { top: -8rpx; }
.coupon-divider-bottom { bottom: -8rpx; }

/* 右侧 */
.coupon-right {
  flex: 1;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.coupon-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coupon-scope {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.coupon-expire {
  font-size: 22rpx;
  color: #C5B9A8;
  margin-top: 6rpx;
  display: block;
}
.coupon-status-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.coupon-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.coupon-status-unused {
  color: #e7a85f;
  background: #fdf3e3;
}
.coupon-status-used {
  color: #999;
  background: #f0ede8;
}
.coupon-status-expired {
  color: #C5B9A8;
  background: #f0ede8;
}
.coupon-action {
  padding: 8rpx 20rpx;
  background: #2D2A26;
  color: #FFFDF9;
  font-size: 22rpx;
  border-radius: 16rpx;
}
.coupon-action:active {
  background: #1f1d1a;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-illu {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F5F0E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-ticket {
  width: 72rpx;
  height: 56rpx;
  background: #C5B9A8;
  border-radius: 4rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  padding: 8rpx 6rpx;
}
.empty-ticket-line {
  height: 1rpx;
  background: #FAF8F5;
  opacity: 0.6;
}
.empty-text {
  font-size: 30rpx;
  color: #8A8278;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #C5B9A8;
  margin-bottom: 32rpx;
}
.empty-btn {
  padding: 16rpx 36rpx;
  background: #FFFDF9;
  border: 1rpx solid #2D2A26;
  border-radius: 8rpx;
  color: #2D2A26;
  font-size: 26rpx;
}
.empty-btn:active {
  background: #f7f5f0;
}

/* 底部说明 */
.coupons-foot {
  margin: 32rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFDF9;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
}
.foot-title {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.foot-item {
  font-size: 22rpx;
  color: #8A8278;
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}
@import 'my-coupons-wxa-auto-dark.wxss'
