<!-- pages/about/about.wxml — 关于我们 / 团队 / 联系方式 -->
<view class="page-about">
  <!-- 头部 Logo -->
  <view class="about-header">
    <view class="logo">
      <view class="logo-icon">
        <view class="car-deco">
          <view class="car-lower"></view>
          <view class="car-upper"></view>
          <view class="car-windshield"></view>
          <view class="car-hood"></view>
          <view class="car-headlight"></view>
          <view class="car-grille"></view>
          <view class="car-mirror"></view>
          <view class="car-arch-front"></view>
          <view class="car-arch-rear"></view>
          <view class="car-wheel-front"></view>
          <view class="car-wheel-rear"></view>
        </view>
      </view>
    </view>
    <text class="app-name">滴滴学习版</text>
    <text class="app-version">v1.2.0</text>
    <text class="app-slogan">让每一次出行都更安心</text>
  </view>

  <!-- 公司介绍 -->
  <view class="section">
    <view class="section-title">关于我们</view>
    <view class="section-content">
      <text>滴滴学习版是微信小程序学习交流项目，仿照主流出行应用实现完整叫车流程，作为教学演示用途。</text>
    </view>
  </view>

  <!-- 核心数据 -->
  <view class="stats-grid">
    <view class="stats-item">
      <text class="stats-num">5.8亿+</text>
      <text class="stats-label">注册用户</text>
    </view>
    <view class="stats-item">
      <text class="stats-num">3100万+</text>
      <text class="stats-label">月活司机</text>
    </view>
    <view class="stats-item">
      <text class="stats-num">400+</text>
      <text class="stats-label">覆盖城市</text>
    </view>
  </view>

  <!-- 功能特色 -->
  <view class="section">
    <view class="section-title">产品特色</view>
    <view
      wx:for="{{features}}"
      wx:key="key"
      class="feature-row"
    >
      <view class="feature-num">{{index + 1}}</view>
      <view class="feature-content">
        <text class="feature-name">{{item.name}}</text>
        <text class="feature-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 开发团队(整块可点 → 完整展示页;联系方式已迁移到 team 页) -->
  <view class="section">
    <view class="section-title-row" bindtap="onOpenTeam" hover-class="section-title-row-hover" hover-stay-time="80">
      <text class="section-title">开发团队</text>
      <text class="section-hint section-hint-link">查看完整团队 ›</text>
    </view>
    <view
      wx:for="{{teamMembers}}"
      wx:key="id"
      wx:for-item="member"
      class="team-block team-block-link"
      data-id="{{member.id}}"
      bindtap="onOpenTeam"
      hover-class="md-card-active"
      hover-stay-time="100"
    >
      <!-- 成员头部:头像 + 名字 + 角色 + 描述 -->
      <view class="team-card">
        <view class="team-avatar">{{member.avatar}}</view>
        <view class="team-info">
          <view class="team-name-row">
            <text class="team-name">{{member.name}}</text>
            <text class="team-role">{{member.role}}</text>
          </view>
          <text class="team-desc">{{member.desc}}</text>
        </view>
        <text class="team-block-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于信息(精简为无值条目) -->
  <view class="section">
    <view class="about-item" bindtap="onCheckUpdate">
      <text class="about-label">检查更新</text>
      <text class="about-value about-value-copy">v1.2.0</text>
      <text class="about-arrow">›</text>
    </view>
    <view class="about-item" bindtap="onOpenAgreement">
      <text class="about-label">用户协议</text>
      <text class="about-arrow">›</text>
    </view>
    <view class="about-item" bindtap="onOpenPrivacy">
      <text class="about-label">隐私政策</text>
      <text class="about-arrow">›</text>
    </view>
    <view class="about-item" bindtap="onOpenCopyright">
      <text class="about-label">版权信息</text>
      <view class="about-copyright-wrap">
        <text class="about-value about-value-copy">© 2026 Ouyang Jason</text>
        <text class="about-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="about-foot">
    <text>本项目仅用于学习交流用途</text>
    <text class="about-foot-declare">开发者 @Ouyang Jason · 仅作技术研究与教学演示,非商业用途</text>
  </view>
</view>
