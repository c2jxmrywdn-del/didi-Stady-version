/* pages/privacy/privacy.wxss */
.page-privacy {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 60rpx;
}

/* 顶部声明 */
.top-notice {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 16rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #e3f3e3 0%, #c8e6c8 100%);
  border-radius: 12rpx;
  border: 1rpx solid #5CAA5C;
}
.notice-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #5CAA5C;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.mi-shield-w {
  width: 24rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  position: relative;
}
.mi-shield-w::after {
  content: "✓";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 16rpx;
  font-weight: bold;
}
.notice-content {
  flex: 1;
  min-width: 0;
}
.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 6rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #3a5c3a;
  display: block;
  line-height: 1.5;
}

.update-info {
  text-align: center;
  font-size: 22rpx;
  color: #C5B9A8;
  padding: 20rpx 24rpx 8rpx;
  letter-spacing: 1rpx;
}

/* 摘要卡片 */
.summary-section {
  background: #FFFDF9;
  margin: 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  padding: 24rpx;
}
.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #5CAA5C;
}
.summary-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}
.summary-bullet {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.summary-bullet-green {
  background: #5CAA5C;
}
.summary-item text {
  font-size: 26rpx;
  color: #5C554C;
  line-height: 1.6;
  flex: 1;
}

/* 内容区 */
.content-section {
  background: #FFFDF9;
  margin: 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  padding: 24rpx;
}
.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #2D2A26;
  letter-spacing: 1rpx;
}
.content-text {
  font-size: 26rpx;
  color: #5C554C;
  line-height: 1.8;
}
.content-text text {
  display: block;
  margin-bottom: 12rpx;
}
.content-text text:last-child {
  margin-bottom: 0;
}
.text-bold {
  font-weight: 600;
  color: #2D2A26;
}
.text-thanks {
  color: #5CAA5C;
  font-weight: 500;
  text-align: center;
  padding: 16rpx 0;
  letter-spacing: 1rpx;
}
@import 'privacy-wxa-auto-dark.wxss'
