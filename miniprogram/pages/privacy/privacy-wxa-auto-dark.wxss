/* 
使用方法：
在 privacy.wxss 文件末尾引入样式
```
@import "./privacy-wxa-auto-dark.wxss";
```
 */

@media (prefers-color-scheme: dark) {
    .page-privacy {
        background: rgb(23, 22, 20);
    }

    .top-notice {
        background: rgb(0, 0, 0);
        border: rgb(0, 0, 0);
    }

    .notice-icon {
        background: rgb(31, 113, 40);
    }

    .mi-shield-w {
        border: rgb(0, 0, 0);
    }

    .mi-shield-w::after {
        color: rgb(17, 17, 17);
    }

    .notice-title {
        color: rgb(223, 219, 214);
    }

    .notice-text {
        color: rgb(142, 179, 140);
    }

    .update-info {
        color: rgb(77, 67, 53);
    }

    .summary-section {
        background: rgb(20, 18, 15);
        border: rgb(0, 0, 0);
    }

    .summary-title {
        color: rgb(223, 219, 214);
        border-bottom: rgb(0, 0, 0);
    }

    .summary-bullet {
        color: rgb(17, 17, 17);
    }

    .summary-bullet-green {
        background: rgb(31, 113, 40);
    }

    .summary-item text {
        color: rgb(174, 165, 155);
    }

    .content-section {
        background: rgb(20, 18, 15);
        border: rgb(0, 0, 0);
    }

    .content-title {
        color: rgb(223, 219, 214);
        border-bottom: rgb(0, 0, 0);
    }

    .content-text {
        color: rgb(174, 165, 155);
    }

    .text-bold {
        color: rgb(223, 219, 214);
    }

    .text-thanks {
        color: rgb(31, 113, 40);
    }
}
