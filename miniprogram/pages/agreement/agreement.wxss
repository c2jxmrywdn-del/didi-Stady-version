/* pages/agreement/agreement.wxss */
.page-agreement {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 200rpx;
}

/* 顶部声明 */
.top-notice {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 16rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fdf3e3 0%, #f7e6c2 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e7a85f;
}
.notice-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e7a85f;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.mi-info {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  position: relative;
}
.mi-info::after {
  content: "i";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  font-weight: bold;
  font-style: italic;
  color: #fff;
  font-family: serif;
  line-height: 1;
}
.notice-content {
  flex: 1;
  min-width: 0;
}
.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 6rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #8A6E47;
  display: block;
  line-height: 1.5;
}

.update-info {
  text-align: center;
  font-size: 22rpx;
  color: #C5B9A8;
  padding: 20rpx 24rpx 8rpx;
  letter-spacing: 1rpx;
}

/* 内容区 */
.content-section {
  background: #FFFDF9;
  margin: 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  padding: 24rpx;
}
.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #2D2A26;
  letter-spacing: 1rpx;
}
.content-text {
  font-size: 26rpx;
  color: #5C554C;
  line-height: 1.8;
}
.content-text text {
  display: block;
  margin-bottom: 12rpx;
}
.content-text text:last-child {
  margin-bottom: 0;
}
.text-bold {
  font-weight: 600;
  color: #e74c3c;
}

/* 底部确认 */
.bottom-agree {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFDF9;
  border-top: 1rpx solid #EDE8E0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.agree-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C5B9A8;
  background: #FFFDF9;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.agree-checked {
  border-color: #2D2A26;
  background: #2D2A26;
}
.agree-check-mark {
  width: 12rpx;
  height: 6rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -1rpx);
}
.agree-text {
  font-size: 26rpx;
  color: #2D2A26;
  flex: 1;
}
.agree-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FAF8F5;
  color: #C5B9A8;
  border: 1rpx solid #EDE8E0;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 0;
  letter-spacing: 1rpx;
}
.agree-btn-active {
  background: #2D2A26;
  color: #FFFDF9;
  border-color: #2D2A26;
}
.agree-btn[disabled] {
  opacity: 1;
}
.agree-btn::after {
  border: none;
}
@import 'agreement-wxa-auto-dark.wxss'
