/* pages/emergency-contact/emergency-contact.wxss */
.page-emg {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 160rpx;
}
.page-tip {
  background: #FFFDF9;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #EDE8E0;
}
.page-tip text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}
.emg-list {
  padding: 16rpx 24rpx;
}
.emg-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFFDF9;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8E0;
  margin-bottom: 16rpx;
}
.emg-item:active {
  background: #f7f5f0;
}
.emg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e7a85f 0%, #d89348 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.emg-avatar-letter {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}
.emg-info {
  flex: 1;
  min-width: 0;
}
.emg-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.emg-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
}
.emg-relation {
  font-size: 22rpx;
  color: #C5B9A8;
  padding: 2rpx 10rpx;
  background: #FAF8F5;
  border-radius: 4rpx;
}
.emg-phone {
  font-size: 26rpx;
  color: #5C554C;
  display: block;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.emg-call {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.emg-call:active {
  background: #f0ede8;
}
.mi-phone {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #2D2A26;
  border-radius: 4rpx 4rpx 6rpx 6rpx;
  position: relative;
  transform: rotate(135deg);
}
.mi-phone::after {
  content: "";
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #2D2A26;
  border-radius: 4rpx 4rpx 0 0;
  border-bottom: none;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-illu {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F5F0E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-phone {
  position: relative;
  width: 50rpx;
  height: 50rpx;
}
.empty-phone-handle {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 16rpx;
  background: #C5B9A8;
  border-radius: 4rpx 4rpx 0 0;
}
.empty-phone-body {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50rpx;
  height: 36rpx;
  background: #C5B9A8;
  border-radius: 6rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #8A8278;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #C5B9A8;
  text-align: center;
  padding: 0 60rpx;
}

/* 添加按钮 */
.add-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx 40rpx;
  background: linear-gradient(180deg, transparent, #FAF8F5 20%);
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  background: #2D2A26;
  color: #FFFDF9;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.add-btn:active { background: #1f1d1a; }
.mi-plus {
  width: 24rpx; height: 24rpx;
  position: relative;
}
.mi-plus::before, .mi-plus::after {
  content: "";
  position: absolute;
  background: #FFFDF9;
}
.mi-plus::before { top: 50%; left: 0; right: 0; height: 2rpx; transform: translateY(-50%); }
.mi-plus::after { left: 50%; top: 0; bottom: 0; width: 2rpx; transform: translateX(-50%); }

/* 操作菜单 */
.action-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.action-card {
  background: #FFFDF9;
  width: 100%;
  border-radius: 16rpx 16rpx 0 0;
  padding: 32rpx 0 48rpx;
}
.action-title {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0ede8;
}
.action-item {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #111;
  border-bottom: 1rpx solid #f7f7f7;
}
.action-item:active { background: #f7f5f0; }
.action-danger { color: #e74c3c; }
.action-cancel {
  margin-top: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  background: #FAF8F5;
  border-top: 6rpx solid #FFFDF9;
}
@import 'emergency-contact-wxa-auto-dark.wxss'
