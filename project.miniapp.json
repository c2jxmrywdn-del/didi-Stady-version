{
  "miniVersion": "v2",
  "name": "%name%",
  "version": "0.0.1",
  "versionCode": 100,
  "i18nFilePath": "i18n",
  "mini-ohos": {
    "sdkVersion": "0.5.1",
    "enableDebug": true
  },
  "mini-android": {
    "resourcePath": "miniapp/android/nativeResources",
    "sdkVersion": "1.6.24",
    "toolkitVersion": "0.11.0",
    "useExtendedSdk": {
      "media": true,
      "bluetooth": true,
      "network": true,
      "scanner": true,
      "xweb": true,
      "xwebEmbed": true,
      "google": true,
      "live": true,
      "skyline": true,
      "nfc": true
    },
    "icons": {
      "hdpi": "",
      "xhdpi": "",
      "xxhdpi": "",
      "xxxhdpi": ""
    },
    "splashscreen": {
      "hdpi": "",
      "xhdpi": "",
      "xxhdpi": ""
    },
    "enableVConsole": "open",
    "privacy": {
      "enable": true,
      "enableViewOnly": true
    },
    "usePluginSdk": {
      "map": "1.2.7"
    },
    "officialPlugins": {
      "imPush": {
        "enable": true
      }
    },
    "map": {
      "qmapAPIKey": "${TENCENT_MAP_API_KEY_ANDROID}"
    }
  },
  "mini-ios": {
    "sdkVersion": "1.7.0",
    "toolkitVersion": "0.0.9",
    "useExtendedSdk": {
      "WeAppOpenFuns": true,
      "WeAppNetwork": true,
      "WeAppBluetooth": true,
      "WeAppMedia": false,
      "WeAppLBS": true,
      "WeAppOthers": true,
      "WeAppOpenFuns_HasPay": true,
      "WeAppIdaas": true,
      "WeAppSkyline": true,
      "WeAppAudio": true,
      "WeAppVideo": true,
      "WeAppImage": true,
      "WeAppCamera": true,
      "WeAppGoogleLogin": true,
      "WeAppLive": true
    },
    "enableVConsole": "open",
    "icons": {
      "mainIcon120": "",
      "mainIcon180": "",
      "spotlightIcon80": "",
      "spotlightIcon120": "",
      "settingsIcon58": "",
      "settingsIcon87": "",
      "notificationIcon40": "",
      "notificationIcon60": "",
      "appStore1024": ""
    },
    "splashScreen": {
      "customImage": ""
    },
    "privacy": {
      "enable": true,
      "enableNativePlugin": true,
      "enableViewOnly": true
    },
    "enableOpenUrlNavigate": true,
    "enableIpad": true,
    "enableDebugLog": true,
    "qmapAPIKey": "${TENCENT_MAP_API_KEY_IOS}",
    "officialPlugins": {
      "imPush": {
        "enableNSE": true
      }
    }
  },
  "mini-plugin": {
    "android": [
      {
        "open": false,
        "pluginId": "",
        "pluginVersion": ""
      }
    ]
  }
}
