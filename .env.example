# ============================================
# 滴滴学习版 · 环境变量模板
# ============================================
# 安全提示:
#   1. 复制本文件为 .env,填入真实密钥
#   2. .env 已在 .gitignore 中,不会被提交
#   3. 真实密钥通过以下途径配置到运行环境:
#      - 微信云开发控制台 → 云函数 → 配置 → 环境变量(推荐)
#      - IDE / 终端:source .env
#      - CI/CD:GitHub Secrets / 微信云托管环境变量
# ============================================

# ---------- 微信支付(云函数 wxpayFunctions)----------
WXPAY_MCH_ID=your_merchant_id_here
WXPAY_MCH_KEY=your_32_char_api_v2_key_here
WXPAY_NOTIFY_URL=https://your-domain.com/pay/notify

# ---------- 百度地图(云函数 baiduMap / .mcp.json)----------
# 服务端 AK(必须开启「服务端」类型,在百度地图开放平台申请)
BAIDU_MAP_AK=your_baidu_map_server_ak
# MCP 工具用的 AK(可以是浏览器端类型)
BAIDU_MAP_API_KEY=your_baidu_map_browser_key

# ---------- 腾讯地图(多端构建 project.miniapp.json)----------
# Android 端
TENCENT_MAP_API_KEY_ANDROID=your_tencent_map_android_key
# iOS 端
TENCENT_MAP_API_KEY_IOS=your_tencent_map_ios_key
